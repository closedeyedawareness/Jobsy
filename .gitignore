# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Environments
.venv/
venv/
env/

# Streamlit local secrets
.streamlit/secrets.toml

# OS / editor
.DS_Store
docs/delivery-log.*
provenance-inventory.*
jobsy_reference_library.backup-*.xlsx
jobsy_reference_library.pre-*.xlsx

# Employee rosters — customer data, never reference data. Name + gender + salary
# is the one genuinely personal combination this project handles, and it is why
# RLS is on the employees table rather than theoretical. A roster dropped in the
# working directory to test with must not become a commit.
#
# A DELIBERATE demo roster is welcome, but under fixtures/ with a name that says
# it is synthetic — so nothing loose in the repo root is ever ambiguous.
*people*.csv
*employees*.csv
/Employees*.xlsx
/Employees*.csv
!fixtures/synthetic-*.csv

# ── secrets ─────────────────────────────────────────────────────────────
# .streamlit/secrets.toml is already covered above; these are the general
# shapes, so a new credential file cannot be committed by accident. Nothing
# here is retroactive: a key committed once survives deletion, and the only
# real remedy then is to rotate it.
.env
.env.*
!.env.example
*.env
secrets.*
.secrets/
config.local.*
credentials*
*.pem
*.key
*.p12
*.pfx
*_rsa
*_rsa.pub
id_*
*service-account*.json
*serviceaccount*.json
.netrc
.npmrc
